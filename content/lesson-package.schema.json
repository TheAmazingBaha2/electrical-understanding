{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "curriculum": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section": {
          "enum": [
            "exam",
            "textbooks",
            "labs",
            "math",
            "reviews"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "source_title": {
          "type": "string",
          "minLength": 1
        },
        "chapter_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "chapter_title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "number"
        },
        "dashboard": {
          "type": "boolean"
        }
      },
      "required": [
        "section",
        "source_id",
        "source_title",
        "chapter_id",
        "chapter_title",
        "order",
        "dashboard"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "book": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "chapter": {
          "type": "string",
          "minLength": 1
        },
        "printedPages": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "book",
        "edition",
        "chapter",
        "printedPages"
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "printedPages": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description",
          "printedPages"
        ]
      },
      "minItems": 1
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        },
        "required": [
          "heading",
          "body",
          "source_ids"
        ]
      },
      "minItems": 1
    },
    "workedExamples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        },
        "required": [
          "title",
          "steps",
          "result",
          "source_ids"
        ]
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "kind": {
            "enum": [
              "discussion",
              "prediction"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "debrief": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "prompt",
          "debrief",
          "source_ids"
        ]
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "widget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "version": {
                "const": "1.0.0"
              },
              "config": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "version",
              "config"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "prompt",
          "expected",
          "explanation",
          "source_ids"
        ]
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "type": {
            "enum": [
              "choice",
              "number",
              "reflection"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "correct": {
            "type": "integer",
            "minimum": 0
          },
          "answer": {
            "type": "number"
          },
          "tolerance": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string"
          },
          "rubric": {
            "type": "string",
            "minLength": 1
          },
          "explain": {
            "type": "string",
            "minLength": 1
          },
          "safety": {
            "type": "boolean"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        },
        "required": [
          "id",
          "type",
          "prompt",
          "explain",
          "safety",
          "source_ids"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "choice"
                }
              }
            },
            "then": {
              "required": [
                "choices",
                "correct"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "number"
                }
              }
            },
            "then": {
              "required": [
                "answer",
                "tolerance",
                "unit"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "reflection"
                }
              }
            },
            "then": {
              "required": [
                "rubric"
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "reviewRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passFraction": {
          "const": 0.8
        },
        "missedDays": {
          "const": 1
        },
        "initialSuccessDays": {
          "const": 7
        },
        "retrySuccessDays": {
          "const": 21
        }
      },
      "required": [
        "passFraction",
        "missedDays",
        "initialSuccessDays",
        "retrySuccessDays"
      ]
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "owner-approved"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "status",
        "reviewedBy",
        "approvedAt"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "curriculum",
    "source",
    "references",
    "objectives",
    "sections",
    "workedExamples",
    "checkpoints",
    "activities",
    "questions",
    "reviewRules",
    "prerequisites",
    "approval"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:electrical-workbench:lesson:1",
  "title": "Electrical Workbench externally authored lesson package v1"
}
